# Modelo do arquivo .env. Copie para ".env" (na mesma pasta) e preencha.
# O .env esta no .gitignore: a sua chave nunca vai para o GitHub.

# Banco de dados (os mesmos valores sao usados pelo docker-compose.yml para criar o Postgres)
DB_USERNAME=
DB_PASSWORD=
# Opcional: so precisa se o banco nao estiver em localhost:5432/gamelibrary
# DB_URL=jdbc:postgresql://localhost:5432/gamelibrary

# Chave da API da Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Seu SteamID64 (17 digitos, comeca com 7656...). Aparece na URL do perfil
# (steamcommunity.com/profiles/7656...) ou em https://steamid.io
STEAM_ID=

# Chave que assina os tokens de login (JWT). OBRIGATORIA: sem ela a aplicacao nao sobe.
# Gere uma chave aleatoria com:
#   openssl rand -base64 48
# e cole o resultado inteiro aqui, numa linha so. (Use 48 e nao 64: com 64 o openssl quebra o
# resultado em duas linhas, e a segunda se perderia.) Cada ambiente deve ter a sua; nunca use a dos testes.
# Se a chave vazar, troque: todos os tokens antigos deixam de valer na hora.
JWT_SECRET=

# Opcional: validade do token em minutos (padrao 60)
# JWT_EXPIRACAO_MINUTOS=60

# Opcional: endereco do front-end que pode chamar a API pelo navegador (padrao http://localhost:4200).
# Uma origem so, sem barra no final e nunca "*".
# CORS_ORIGEM=http://localhost:4200

# Opcional: so se o navegador nao salvar o cookie de login no desenvolvimento (padrao true).
# Nunca use false em producao: o cookie passaria a trafegar tambem por HTTP sem criptografia.
# COOKIE_SECURE=false
