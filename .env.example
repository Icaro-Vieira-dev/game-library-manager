# Modelo do arquivo .env. Copie para ".env" (na mesma pasta) e preencha.
# O .env esta no .gitignore: a sua chave nunca vai para o GitHub.

# Banco de dados (os mesmos valores sao usados pelo docker-compose.yml para criar o Postgres)
DB_USERNAME=
DB_PASSWORD=
# Opcional: so precisa se o banco nao estiver em localhost:5432/gamelibrary
# DB_URL=jdbc:postgresql://localhost:5432/gamelibrary

# Chave da API da Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Seu SteamID64 (17 digitos, comeca com 7656...). Aparece na URL do perfil
# (steamcommunity.com/profiles/7656...) ou em https://steamid.io
STEAM_ID=
